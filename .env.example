# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=*
# Bỏ trống để dùng SQLite cục bộ; production dùng PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Redis cho Celery (bỏ trống thì Celery chạy eager, dùng lệnh send_deadline_reminders)
REDIS_URL=
# ---- AI hỗ trợ (chọn 1; ưu tiên theo thứ tự) ----
# 1) Ollama (Colab / máy cá nhân) qua API chuẩn OpenAI:
# AI_BASE_URL=https://ten-ngau-nhien.trycloudflare.com/v1
# AI_API_KEY=
# AI_MODEL=qwen2.5:7b
# 2) Google Gemini (https://aistudio.google.com/apikey):
GEMINI_API_KEY=
# 3) OpenAI:
OPENAI_API_KEY=
# Đổi model cho Gemini/OpenAI (tùy chọn): AI_MODEL=gemini-flash-latest
# AI_TIMEOUT_SECONDS=60
REMINDER_HOURS_BEFORE=24
# Email qua Brevo API (xác thực tài khoản, quên mật khẩu, nhắc deadline).
# Không đặt BREVO_API_KEY thì email được in ra console.
BREVO_API_KEY=
# Phải là sender đã xác minh trong Brevo (Senders, Domains & Dedicated IPs)
DEFAULT_FROM_EMAIL=StudyPlanner <ban@gmail.com>
# Hoặc dùng SMTP (Brevo SMTP relay / Gmail) thay cho API:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
