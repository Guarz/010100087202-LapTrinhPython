# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=*
# Bỏ trống để dùng SQLite cục bộ; production dùng PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Redis cho Celery (bỏ trống thì Celery chạy eager, dùng lệnh send_deadline_reminders)
REDIS_URL=
OPENAI_API_KEY=
REMINDER_HOURS_BEFORE=24
# Email SMTP (mặc định in ra console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
